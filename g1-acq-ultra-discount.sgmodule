#!name=G1 ACQ Ultra 75p
#!desc=v7.8.0 固定三个月75p（75% off、实付25%、2.5折）：20TB → g1.20tb.3months_ip_75p.acq、30TB → g1.ai.ultra.3months_ip_75p.acq，源匹配即改写，无Ultra备用，fallback=false；mode=discount75，运行版本g1-acq-v7.8-75p；2TB 12个月优惠目标g1.2tb.ai.12months_ip_90p（无 .acq）保留；被动采集、最近10次响应、本机报告与JSON导出；关闭旧模块后只开启一个改写入口，重新连接再打开方案页
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.8.0/g1-acq-discount.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.8.0/g1-sku-report-discount.js

[MITM]
hostname = %APPEND% one.google.com
