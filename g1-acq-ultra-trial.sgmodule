#!name=G1 ACQ Ultra 试用
#!desc=v7.7.0 试用优先入口：20TB 默认 g1.20tb.1month_eft.acq、30TB 默认 g1.ai.ultra.1month_eft.acq，各档默认缺失且自己的三个月90p备用出现时才回退；两者均缺失仍选默认；2TB 12个月优惠目标 g1.2tb.ai.12months_ip_90p（无 .acq）；被动采集、最近10次响应、本机报告与 JSON 导出；只开启一个改写入口，切换后重新连接再打开方案页
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.7.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.7.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
