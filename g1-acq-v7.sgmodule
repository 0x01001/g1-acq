#!name=G1 ACQ
#!desc=v7.3.0：单模块自动采集原始 SKU + 2TB 用户指定候选 g1.2tb.ai.annual_ip_90p.acq + 20TB/30TB 原优惠映射与回退；本机报告支持导出 JSON
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.3.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.3.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
