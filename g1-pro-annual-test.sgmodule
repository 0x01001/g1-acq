#!name=G1 Pro Annual Test
#!desc=v7.7.0 试用优先兼容入口：引用 g1-acq-v7.7-trial，20TB 默认 g1.20tb.1month_eft.acq、30TB 默认 g1.ai.ultra.1month_eft.acq，各档默认缺失且自己的三个月90p备用出现时才回退；2TB 12个月优惠目标 g1.2tb.ai.12months_ip_90p（无 .acq）；保留 /ai? 匹配范围与最近10次响应诊断；新主入口为 G1 ACQ Ultra 一折 / G1 ACQ Ultra 试用，只开启一个改写入口
#!system=ios

[Rule]
# 与旧模块相同：拦截 UDP 443，作用于使用该配置的流量。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.7.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.7.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
